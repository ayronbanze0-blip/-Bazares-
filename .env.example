# Porta do servidor
PORT=4000
NODE_ENV=development

# URL do frontend (para CORS)
FRONTEND_URL=http://localhost:5500

# Segredo usado para assinar os tokens de login (JWT).
# Troque por qualquer texto longo e aleatório antes de colocar em produção.
JWT_SECRET=troque-este-segredo-por-um-valor-aleatorio-longo
